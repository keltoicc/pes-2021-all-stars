---
import PageHeader from "../../components/ui/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";

import ContinentList from "../../components/continents/ContinentList.astro";

import ContinentRepository from "../../lib/repositories/ContinentRepository";

const continents = ContinentRepository.getAll();
---

<Layout title="Continents">

    <PageHeader
        title="Continents"
        description="Explore the database by continent and country."
    />

    <ContinentList continents={continents} />

</Layout>