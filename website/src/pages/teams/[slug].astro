---
import Layout from "../../layouts/Layout.astro";

import TeamHeader from "../../components/teams/TeamHeader.astro";
import Section from "../../components/ui/Section.astro";

import TeamRepository from "../../lib/repositories/TeamRepository";
import SquadRepository from "../../lib/repositories/SquadRepository";
import CountryRepository from "../../lib/repositories/CountryRepository";

import SquadList from "../../components/squads/SquadList.astro";

export function getStaticPaths() {
    const teams = TeamRepository.getAll();

    return teams.map(team => ({
        params: {
            slug: team.slug
        },
        props: {
            team
        }
    }));
}

const { team } = Astro.props;

const squads = SquadRepository.getByTeam(team.id);

const country = CountryRepository.getById(team.country);

if (!country) {
    throw new Error(
        `Country with id ${team.country} not found for team "${team.name}".`
    );
}
---

<Layout title={team.name}>

    <div class="team-page">

        <TeamHeader
            team={team}
            country={country}
        />

        <Section title="Available Squads">

            <SquadList squads={squads} />

        </Section>

    </div>

</Layout>

<style>
.team-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
}
</style>