---
import Layout from "../../layouts/Layout.astro";

import PageHeader from "../../components/ui/PageHeader.astro";
import Section from "../../components/ui/Section.astro";
---

<Layout title="Teams">

    <div class="teams-page">

        <PageHeader
            title="Teams"
            description="Browse teams available in the Classic Football Encyclopedia."
        />

        <Section title="Browse Teams">

            <ul>

                <li>
                    <a href={`${import.meta.env.BASE_URL}teams/all-teams/`}>
                        All Teams
                    </a>
                </li>

                <li>
                    <a href={`${import.meta.env.BASE_URL}teams/countries/`}>
                        By Country
                    </a>
                </li>

            </ul>

        </Section>

    </div>

</Layout>

<style>
.teams-page {
    display: flex;
    flex-direction: column;
}
</style>