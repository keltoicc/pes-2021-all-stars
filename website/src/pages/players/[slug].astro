---
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";

import PlayerHeader from "../../components/players/PlayerHeader.astro";
import PlayerCareer from "../../components/players/PlayerCareer.astro";
import PlayerVersionList from "../../components/playerVersions/PlayerVersionList.astro";

import PlayerRepository from "../../lib/repositories/PlayerRepository";
import PlayerVersionRepository from "../../lib/repositories/PlayerVersionRepository";
import CountryRepository from "../../lib/repositories/CountryRepository";
import TeamRepository from "../../lib/repositories/TeamRepository";

import type { CareerEntrySummary } from "../../viewModels/CareerEntrySummary";

export function getStaticPaths() {
    const players = PlayerRepository.getAll();

    return players.map(player => ({
        params: {
            slug: player.slug
        },
        props: {
            player
        }
    }));
}

const { player } = Astro.props;

const country = CountryRepository.getById(player.country);

if (!country) {
    throw new Error(
        `Country with id ${player.country} not found.`
    );
}

const career: CareerEntrySummary[] = (player.career ?? []).map(entry => {

    const team = TeamRepository.getById(entry.team);

    if (!team) {
        throw new Error(
            `Team with id ${entry.team} not found for player "${player.name}".`
        );
    }

    return {
        career: entry,
        team
    };
});

const versions = PlayerVersionRepository.getByPlayer(player.id);
---

<Layout title={player.name}>

    <div class="player-page">

        <Breadcrumbs
            items={[
                {
                    label: "Players",
                    href: "/players/"
                },
                {
                    label: player.name
                }
            ]}
        />

        <PlayerHeader
            player={player}
            country={country}
        />

        <PlayerCareer career={career} />

        <PlayerVersionList versions={versions} />

    </div>

</Layout>

<style>
.player-page {
    display: flex;
    flex-direction: column;
    
    gap: var(--space-6);
}
</style>