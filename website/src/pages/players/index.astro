---
import Layout from "../../layouts/Layout.astro";

import Section from "../../components/ui/Section.astro";
---

<Layout title="Players">

    <div class="players-page">

        <header class="players-page__header">

            <h1>Players</h1>

        </header>

        <Section title="Browse Players">

            <ul>

                <li>
                    <a href="/players/all-players/">
                        All Players
                    </a>
                </li>

                <li>
                    <a href="/players/countries/">
                        By Country
                    </a>
                </li>

                <li>
                    <a href="/players/positions/">
                        By Position
                    </a>
                </li>

            </ul>

        </Section>

    </div>

</Layout>

<style>
.players-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
}

.players-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
}
</style>