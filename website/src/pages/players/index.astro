---
import Layout from "../../layouts/Layout.astro";

import PageHeader from "../../components/ui/PageHeader.astro";
import Section from "../../components/ui/Section.astro";
---

<Layout title="Players">

    <div class="players-page">

        <PageHeader
            title="Players"
            description="Browse players available in the Classic Football Encyclopedia."
        />

        <Section title="Browse Players">

            <ul>

                <li>
                    <a href="/players/all-players/">
                        All Players
                    </a>
                </li>

                <li>
                    <a href="/players/countries/">
                        By Country
                    </a>
                </li>

                <li>
                    <a href="/players/positions/">
                        By Position
                    </a>
                </li>

            </ul>

        </Section>

    </div>

</Layout>

<style>
.players-page {
    display: flex;
    flex-direction: column;
}
</style>