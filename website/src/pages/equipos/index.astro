---
import Layout from "../../layouts/Layout.astro";
import { TeamRepository } from "../../lib/repositories/TeamRepository";

import TeamCard from "../../components/teams/TeamCard.astro";
import Grid from "../../components/ui/Grid.astro";

const teams = TeamRepository.getAll();
---

<Layout title="Equipos">

    <h1>Equipos</h1>

    <Grid>
        {teams.map(team => (
            <TeamCard team={team} />
        ))}
    </Grid>

</Layout>