---
import Layout from "../layouts/Layout.astro";
---

<Layout>

    <div class="home-page">

        <section class="home-hero">

            <div class="home-hero__content">

                <p class="home-hero__eyebrow">
                    PES 2021 All-Stars
                </p>

                <h1>
                    Explore the database
                </h1>

                <p class="home-hero__description">
                    Explore teams, players, squads and historical
                    player versions from the PES 2021 All-Stars project.
                </p>

            </div>

        </section>

        <section class="home-explore">

            <header class="home-explore__header">

                <h2>Explore</h2>

            </header>

            <div class="home-explore__grid">

                <a
                    class="home-explore__item"
                    href={`${import.meta.env.BASE_URL}teams/`}
                >
                    <span class="home-explore__title">
                        Teams
                    </span>

                    <span
                        class="home-explore__arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>
                </a>

                <a
                    class="home-explore__item"
                    href={`${import.meta.env.BASE_URL}players/`}
                >
                    <span class="home-explore__title">
                        Players
                    </span>

                    <span
                        class="home-explore__arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>
                </a>

                <a
                    class="home-explore__item"
                    href={`${import.meta.env.BASE_URL}countries/`}
                >
                    <span class="home-explore__title">
                        Countries
                    </span>

                    <span
                        class="home-explore__arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>
                </a>

                <a
                    class="home-explore__item"
                    href={`${import.meta.env.BASE_URL}continents/`}
                >
                    <span class="home-explore__title">
                        Continents
                    </span>

                    <span
                        class="home-explore__arrow"
                        aria-hidden="true"
                    >
                        →
                    </span>
                </a>

            </div>

        </section>

    </div>

</Layout>

<style>
.home-page {
    display: flex;
    flex-direction: column;

    gap: var(--space-8);
}

.home-hero {
    max-width: var(--content-width);

    padding: var(--space-8) var(--space-6);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
}

.home-hero__content {
    display: flex;
    flex-direction: column;

    gap: var(--space-3);
}

.home-hero__eyebrow {
    margin: 0;

    color: var(--color-primary);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.home-hero h1 {
    margin: 0;

    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
}

.home-hero__description {
    max-width: 650px;

    margin: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
}

.home-explore {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);

    max-width: var(--content-width);
}

.home-explore__header {
    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.home-explore__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.home-explore__grid {
    display: grid;

    grid-template-columns: repeat(
        2,
        minmax(0, 1fr)
    );

    gap: var(--space-3);
}

.home-explore__item {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-4);

    padding: var(--space-4);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    color: inherit;
    text-decoration: none;

    transition:
        background-color 150ms ease,
        color 150ms ease,
        border-color 150ms ease;
}

.home-explore__title {
    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
}

.home-explore__arrow {
    color: var(--color-text-muted);

    transition:
        color 150ms ease,
        transform 150ms ease;
}

.home-explore__item:hover {
    color: var(--color-primary);
}

.home-explore__item:hover .home-explore__arrow {
    color: var(--color-primary);
    transform: translateX(3px);
}

.home-explore__item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

@media (max-width: 600px) {

    .home-hero {
        padding: var(--space-6) var(--space-4);
    }

    .home-hero h1 {
        font-size: var(--font-size-2xl);
    }

    .home-explore__grid {
        grid-template-columns: 1fr;
    }

}
</style>