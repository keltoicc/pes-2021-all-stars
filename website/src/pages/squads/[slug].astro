---
import Layout from "../../layouts/Layout.astro";

import SquadHeader from "../../components/squads/SquadHeader.astro";
import Section from "../../components/ui/Section.astro";
import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import SquadMemberList from "../../components/squads/SquadMemberList.astro";

import SquadRepository from "../../lib/repositories/SquadRepository";
import TeamRepository from "../../lib/repositories/TeamRepository";
import ManagerRepository from "../../lib/repositories/ManagerRepository";
import StadiumRepository from "../../lib/repositories/StadiumRepository";
import PlayerRepository from "../../lib/repositories/PlayerRepository";
import PlayerVersionRepository from "../../lib/repositories/PlayerVersionRepository";

import type { SquadMemberSummary } from "../../viewModels/SquadMemberSummary";

export function getStaticPaths() {
    const squads = SquadRepository.getAll();

    return squads.map(squad => ({
        params: {
            slug: squad.slug
        },
        props: {
            squad
        }
    }));
}

const { squad } = Astro.props;

const team = TeamRepository.getById(squad.team);

if (!team) {
    throw new Error(
        `Team with id ${squad.team} not found for squad "${squad.name}".`
    );
}

const manager =
    squad.manager !== undefined
        ? ManagerRepository.getById(squad.manager)
        : undefined;

const stadium =
    squad.stadium !== undefined
        ? StadiumRepository.getById(squad.stadium)
        : undefined;

const members: SquadMemberSummary[] = squad.members.map(member => {
    if (member.playerVersion === undefined) {
        return { member };
    }
    const playerVersion =
        PlayerVersionRepository.getById(member.playerVersion);
    if (!playerVersion) {
        return { member };
    }
    const player =
        PlayerRepository.getById(playerVersion.player);
    return {
        member,
        playerVersion,
        player
    };
});


---

<Layout title={squad.name}>

    <div class="squad-page">

        <Breadcrumbs

            items={[
                {
                    label: "Teams",
                    href: `${import.meta.env.BASE_URL}teams/`
                },
                {
                    label: team.name,
                    href: `${import.meta.env.BASE_URL}teams/${team.slug}`
                },
                {
                    label: squad.name
                }
            ]}

        />

        <SquadHeader
            squad={squad}
            team={team}
            manager={manager}
            stadium={stadium}
        />

        <SquadMemberList members={members} />

    </div>

</Layout>

<style>
.squad-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
}
</style>