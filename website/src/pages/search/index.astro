---
import Layout from "../../layouts/Layout.astro";
import SearchResults from "../../components/search/SearchResults.astro";
---

<Layout title="Search">

    <main class="container">

        <header>
            <h1>Search</h1>

            <p id="search-query">
                Enter a search term to find players, teams and countries.
            </p>
        </header>

        <SearchResults />

    </main>

    <script>
        import SearchService from "../../lib/search/SearchService";
        import SearchRenderer from "../../lib/search/SearchRenderer";

        const params = new URLSearchParams(window.location.search);
        const query = params.get("q")?.trim() ?? "";

        const queryElement = document.querySelector("#search-query");
        const resultsElement = document.querySelector("#search-result-list");

        if (query) {

            queryElement!.innerHTML =
                `Results for <strong>“${query}”</strong>`;

            const results = await SearchService.search(query);

            if (results.length === 0) {

                resultsElement!.textContent = "No results found.";

            } else {

                SearchRenderer.render(
                    results,
                    resultsElement as HTMLElement
                );

            }
        }
    </script>

</Layout>