---
import Layout from "../../layouts/Layout.astro";

import Breadcrumbs from "../../components/ui/Breadcrumbs.astro";
import CountryHeader from "../../components/countries/CountryHeader.astro";
import Section from "../../components/ui/Section.astro";
import TeamList from "../../components/teams/TeamList.astro";

import CountryRepository from "../../lib/repositories/CountryRepository";
import TeamRepository from "../../lib/repositories/TeamRepository";

import type { TeamSummary } from "../../viewModels/TeamSummary";

export function getStaticPaths() {

    return CountryRepository.getAll().map(country => ({
        params: {
            slug: country.slug
        }
    }));

}

const { slug } = Astro.params;

if (!slug) {
    throw new Error("Missing country slug.");
}

const country = CountryRepository.getBySlug(slug);

if (!country) {
    throw new Error(`Country "${slug}" not found.`);
}

const teams = TeamRepository.getByCountry(country.id);

const summaries: TeamSummary[] = teams.map(team => ({
    team,
    country
}));
---

<Layout title={country.name}>

    <div class="country-page">

        <Breadcrumbs
            items={[
                {
                    label: "Countries",
                    href: `${import.meta.env.BASE_URL}countries/`
                },
                {
                    label: country.name
                }
            ]}
        />

        <CountryHeader country={country} />

        <Section title="Teams">

            {
                summaries.length > 0
                    ? <TeamList teams={summaries} />
                    : <p>No teams available.</p>
            }

        </Section>

    </div>

</Layout>

<style>
.country-page {
    display: flex;
    flex-direction: column;

    gap: var(--space-8);
}
</style>