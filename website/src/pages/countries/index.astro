---
import PageHeader from "../../components/ui/PageHeader.astro";
import Layout from "../../layouts/Layout.astro";

import CountryList from "../../components/countries/CountryList.astro";

import CountryRepository from "../../lib/repositories/CountryRepository";

import TeamRepository from "../../lib/repositories/TeamRepository";

const countryIds = TeamRepository.getCountryIds();

const countries = CountryRepository
    .getAll()
    .filter(country => countryIds.has(country.id));
---

<Layout title="Countries">

    <PageHeader
        title="Countries"
        description="Explore the football countries represented in the database."
    />

    <CountryList countries={countries} />

</Layout>