---
import TeamListItem from "./TeamListItem.astro";
import type { TeamSummary } from "../../viewModels/TeamSummary";

interface Props {
    teams: TeamSummary[];
}

const { teams } = Astro.props;
---

<section class="team-list">

    <div class="team-list__meta">
        {teams.length} {teams.length === 1 ? "team" : "teams"}
    </div>

    <ul>

        {
            teams.map(teamSummary => (
                <TeamListItem summary={teamSummary} />
            ))
        }

    </ul>

</section>

<style>
.team-list {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);
}

.team-list__meta {
    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}
</style>