---
import TeamListItem from "./TeamListItem.astro";
import type { Team } from "../../types/team";

interface Props {
    teams: Team[];
}

const { teams } = Astro.props;
---

<section>

    <h1>Teams</h1>

    <ul>

        {
            teams.map(team => (
                <TeamListItem team={team} />
            ))
        }

    </ul>

</section>

<style>
section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}
</style>