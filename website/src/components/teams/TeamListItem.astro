---
import type { TeamSummary } from "../../viewModels/TeamSummary";

interface Props {
    summary: TeamSummary;
}

const { summary } = Astro.props;
---

<li class="team-list-item">

    <a href={`/teams/${summary.team.slug}`}>

        <img
            src={summary.team.crest}
            alt={`${summary.team.name} crest`}
        />

        <div class="team-list-item__info">

            <h2>{summary.team.name}</h2>

            <p>{summary.country.name}</p>

        </div>

        <span class="team-list-item__arrow" aria-hidden="true">
            →
        </span>

    </a>

</li>

<style>
.team-list-item {
    border-bottom: 1px solid var(--color-border);
}

.team-list-item:first-child {
    border-top: 1px solid var(--color-border);
}

.team-list-item a {
    position: relative;

    display: flex;
    align-items: center;

    gap: var(--space-4);

    min-height: 72px;

    padding: var(--space-3) var(--space-4);

    color: var(--color-text);

    transition:
        background-color 150ms ease,
        color 150ms ease;
}

.team-list-item img {
    width: 48px;
    height: 48px;

    flex-shrink: 0;

    object-fit: contain;
}

.team-list-item__info {
    min-width: 0;
}

.team-list-item h2 {
    margin: 0;

    color: inherit;

    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
}

.team-list-item p {
    margin-top: var(--space-1);

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
}

.team-list-item__arrow {
    margin-left: auto;

    color: var(--color-text-muted);

    font-size: var(--font-size-lg);

    transition:
        color 150ms ease,
        transform 150ms ease;
}

.team-list-item a:hover {
    color: var(--color-primary);
}

.team-list-item a:hover p {
    color: var(--color-text-secondary);
}

.team-list-item a:hover .team-list-item__arrow {
    color: var(--color-primary);
    transform: translateX(3px);
}

.team-list-item a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}
</style>