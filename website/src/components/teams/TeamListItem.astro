---
import type { Team } from "../../types/team";

interface Props {
    team: Team;
}

const { team } = Astro.props;
---

<li>

    <a href={`/teams/${team.slug}`}>

        <img
            src={team.crest}
            alt={`${team.name} crest`}
        />

        <div>

            <h2>{team.name}</h2>

            <p>{team.country}</p>

        </div>

    </a>

</li>

<style>
li {
    border-bottom: 1px solid var(--color-border);
}

a {
    display: flex;
    align-items: center;
    gap: var(--space-4);

    padding-block: var(--space-3);
}

img {
    width: 48px;
    height: 48px;

    object-fit: contain;
}

h2 {
    font-size: 1.1rem;
}

p {
    color: var(--color-text-muted);
}
</style>