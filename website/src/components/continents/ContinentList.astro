---
import type { Continent } from "../../types/continent";
import ContinentListItem from "./ContinentListItem.astro";

interface Props {
    continents: Continent[];
}

const { continents } = Astro.props;
---

<section class="continent-list">

    <div class="continent-list__meta">
        {continents.length} {continents.length === 1 ? "continent" : "continents"}
    </div>

    <ul>

        {
            continents.map(continent => (
                <ContinentListItem continent={continent} />
            ))
        }

    </ul>

</section>

<style>
.continent-list {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);
}

.continent-list__meta {
    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}
</style>