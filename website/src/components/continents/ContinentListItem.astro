---
import type { Continent } from "../../types/continent";

interface Props {
    continent: Continent;
}

const { continent } = Astro.props;
---

<li class="continent-list-item">

    <a href={`${import.meta.env.BASE_URL}continents/${continent.slug}`}>

        <h2>{continent.name}</h2>

        <span class="continent-list-item__arrow" aria-hidden="true">
            →
        </span>

    </a>

</li>

<style>
.continent-list-item {
    border-bottom: 1px solid var(--color-border);
}

.continent-list-item:first-child {
    border-top: 1px solid var(--color-border);
}

.continent-list-item a {
    display: flex;
    align-items: center;

    min-height: 64px;

    padding: var(--space-3) var(--space-4);

    color: var(--color-text);

    transition: color 150ms ease;
}

.continent-list-item h2 {
    margin: 0;

    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
}

.continent-list-item__arrow {
    margin-left: auto;

    color: var(--color-text-muted);

    transition:
        color 150ms ease,
        transform 150ms ease;
}

.continent-list-item a:hover {
    color: var(--color-primary);
}

.continent-list-item a:hover .continent-list-item__arrow {
    color: var(--color-primary);
    transform: translateX(3px);
}

.continent-list-item a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}
</style>