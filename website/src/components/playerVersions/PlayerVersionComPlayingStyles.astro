---
import type { ComPlayingStyles } from "../../enums/comPlayingStyles";

interface Props {
    comPlayingStyles?: ComPlayingStyles[];
}

const { comPlayingStyles } = Astro.props;
---

{
    comPlayingStyles && comPlayingStyles.length > 0 && (

        <section class="player-version-com-playing-styles">

            <header class="player-version-com-playing-styles__header">
                <h2>Com Playing Styles</h2>
            </header>

            <ul>

                {
                    comPlayingStyles.map(style => (
                        <li>
                            {style}
                        </li>
                    ))
                }

            </ul>

        </section>

    )
}

<style>
.player-version-com-playing-styles {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);

    max-width: var(--content-width);
}

.player-version-com-playing-styles__header {
    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.player-version-com-playing-styles__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.player-version-com-playing-styles ul {
    display: flex;
    flex-wrap: wrap;

    gap: var(--space-2);
}

.player-version-com-playing-styles li {
    padding: var(--space-2) var(--space-3);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    color: var(--color-text);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}
</style>