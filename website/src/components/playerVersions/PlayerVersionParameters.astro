---
interface Props {
    weakFootUsage: number;
    weakFootAccuracy: number;
    form: number;
    injuryResistance: number;
}

const {
    weakFootUsage,
    weakFootAccuracy,
    form,
    injuryResistance
} = Astro.props;
---

<section class="player-version-parameters">

    <header class="player-version-parameters__header">
        <h3>Parameters</h3>
    </header>

    <div class="player-version-parameters__grid">

        <div class="parameter">
            <span>Weak Foot Usage</span>
            <strong>{weakFootUsage}</strong>
        </div>

        <div class="parameter">
            <span>Weak Foot Accuracy</span>
            <strong>{weakFootAccuracy}</strong>
        </div>

        <div class="parameter">
            <span>Form</span>
            <strong>{form}</strong>
        </div>

        <div class="parameter">
            <span>Injury Resistance</span>
            <strong>{injuryResistance}</strong>
        </div>

    </div>

</section>

<style>
.player-version-parameters {
    display: flex;
    flex-direction: column;

    gap: var(--space-3);

    max-width: var(--content-width);
}

.player-version-parameters__header {
    padding-inline: var(--space-4);
}

.player-version-parameters__header h3 {
    margin: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
}

.player-version-parameters__grid {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: var(--space-2);
}

.parameter {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
}

.parameter span {
    color: var(--color-text);
}

.parameter strong {
    min-width: 2rem;

    text-align: right;

    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
}

@media (max-width: 700px) {
    .player-version-parameters__grid {
        grid-template-columns: 1fr;
    }
}
</style>