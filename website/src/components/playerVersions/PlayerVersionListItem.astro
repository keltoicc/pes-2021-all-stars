---
import type { PlayerVersion } from "../../types/playerVersion";

interface Props {
    version: PlayerVersion;
}

const { version } = Astro.props;
---

<li>

    <a href={`/player-versions/${version.slug}`}>

        <div class="player-version-list-item__main">

            <span class="player-version-list-item__version">
                {version.version}
            </span>

            <span class="player-version-list-item__seasons">
                {version.fromSeason}–{version.toSeason}
            </span>

        </div>

        <span
            class="player-version-list-item__arrow"
            aria-hidden="true"
        >
            →
        </span>

    </a>

</li>

<style>
li {
    border-bottom: 1px solid var(--color-border);
}

li:first-child {
    border-top: 1px solid var(--color-border);
}

a {
    display: grid;

    grid-template-columns: 1fr auto;

    align-items: center;

    gap: var(--space-4);

    padding: var(--space-4);

    color: var(--color-text);

    transition:
        background-color 150ms ease,
        color 150ms ease;
}

.player-version-list-item__main {
    display: flex;
    align-items: baseline;

    gap: var(--space-4);
}

.player-version-list-item__version {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
}

.player-version-list-item__seasons {
    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);

    white-space: nowrap;
}

.player-version-list-item__arrow {
    color: var(--color-primary);

    font-size: 1.1rem;

    transition: transform 150ms ease;
}

a:hover {
    background: var(--color-surface-muted);
}

a:hover .player-version-list-item__version {
    color: var(--color-primary);
}

a:hover .player-version-list-item__arrow {
    transform: translateX(3px);
}

@media (max-width: 700px) {
    .player-version-list-item__main {
        flex-direction: column;

        align-items: flex-start;

        gap: var(--space-1);
    }

    .player-version-list-item__seasons {
        font-size: var(--font-size-sm);
    }
}
</style>