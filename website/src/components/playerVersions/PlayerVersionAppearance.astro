---
import type { Appearance } from "../../types/appearance";

import AppearanceGroup from "../ui/AppearanceGroup.astro";
import DataGrid from "../ui/DataGrid.astro";

interface Props {
    appearance: Appearance;
}

const { appearance } = Astro.props;
---

<section class="player-version-appearance">

    <header class="player-version-appearance__header">
        <h2>Appearance</h2>
    </header>

    {
        appearance.hairstyle && (
            <AppearanceGroup title="Hairstyle">

                <div class="appearance-subgroup">

                    <h4>Overall</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Style",
                                value: appearance.hairstyle.overall.style
                            },
                            {
                                label: "Length",
                                value: appearance.hairstyle.overall.length
                            },
                            {
                                label: "Wave Level",
                                value: appearance.hairstyle.overall.waveLevel
                            },
                            {
                                label: "Hair Variation",
                                value: appearance.hairstyle.overall.hairVariation
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Front</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Style",
                                value: appearance.hairstyle.front.style
                            },
                            {
                                label: "Parted",
                                value: appearance.hairstyle.front.parted
                            },
                            {
                                label: "Hairline",
                                value: appearance.hairstyle.front.hairline
                            },
                            {
                                label: "Forehead Width",
                                value: appearance.hairstyle.front.foreheadWidth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Side / Back</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Style",
                                value: appearance.hairstyle.sideBack.style
                            },
                            {
                                label: "Cropped",
                                value: appearance.hairstyle.sideBack.cropped
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Hair Colour / Accessory</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Hair Colour",
                                value:
                                    appearance.hairstyle
                                        .hairColourAccessory
                                        .hairColour
                                        .preset
                            },
                            {
                                label: "Accessory",
                                value:
                                    appearance.hairstyle
                                        .hairColourAccessory
                                        .accessory
                                        ? "Yes"
                                        : "No"
                            },
                            {
                                label: "Accessory Colour",
                                value:
                                    appearance.hairstyle
                                        .hairColourAccessory
                                        .accessoryColour
                            }
                        ]}
                    />

                </div>

            </AppearanceGroup>
        )
    }

    {
        appearance.face && (
            <AppearanceGroup title="Face">

                <div class="appearance-subgroup">

                    <h4>Skin Colour / Head Ratio</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Skin Colour",
                                value: appearance.face.skinColourHeadRatio.skinColour
                            },
                            {
                                label: "Head Length",
                                value: appearance.face.skinColourHeadRatio.headLength
                            },
                            {
                                label: "Head Width",
                                value: appearance.face.skinColourHeadRatio.headWidth
                            },
                            {
                                label: "Head Depth",
                                value: appearance.face.skinColourHeadRatio.headDepth
                            },
                            {
                                label: "Face Height",
                                value: appearance.face.skinColourHeadRatio.faceHeight
                            },
                            {
                                label: "Face Size",
                                value: appearance.face.skinColourHeadRatio.faceSize
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Eyes</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Upper Eyelid Type",
                                value: appearance.face.eyes.upperEyelidType
                            },
                            {
                                label: "Bottom Eyelid Type",
                                value: appearance.face.eyes.bottomEyelidType
                            },
                            {
                                label: "Eye Height",
                                value: appearance.face.eyes.eyeHeight
                            },
                            {
                                label: "Horizontal Eye Position",
                                value: appearance.face.eyes.horizontalEyePosition
                            },
                            {
                                label: "Iris Colour",
                                value: appearance.face.eyes.irisColour
                            },
                            {
                                label: "Pupil Size",
                                value: appearance.face.eyes.pupilSize
                            },
                            {
                                label: "Upper Eyelid Height Inner",
                                value: appearance.face.eyes.upperEyelidHeightInner
                            },
                            {
                                label: "Upper Eyelid Width Inner",
                                value: appearance.face.eyes.upperEyelidWidthInner
                            },
                            {
                                label: "Upper Eyelid Height Outer",
                                value: appearance.face.eyes.upperEyelidHeightOuter
                            },
                            {
                                label: "Upper Eyelid Width Outer",
                                value: appearance.face.eyes.upperEyelidWidthOuter
                            },
                            {
                                label: "Inner Eye Height",
                                value: appearance.face.eyes.innerEyeHeight
                            },
                            {
                                label: "Inner Eye Position",
                                value: appearance.face.eyes.innerEyePosition
                            },
                            {
                                label: "Eye Corner Height",
                                value: appearance.face.eyes.eyeCornerHeight
                            },
                            {
                                label: "Outer Eye Position",
                                value: appearance.face.eyes.outerEyePosition
                            },
                            {
                                label: "Bottom Eyelid Height",
                                value: appearance.face.eyes.bottomEyelidHeight
                            },
                            {
                                label: "Eye Depth",
                                value: appearance.face.eyes.eyeDepth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Forehead / Brows</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Forehead",
                                value: appearance.face.foreheadBrows.forehead
                            },
                            {
                                label: "Eyebrow Type",
                                value: appearance.face.foreheadBrows.eyebrowType
                            },
                            {
                                label: "Eyebrow Thickness",
                                value: appearance.face.foreheadBrows.eyebrowThickness
                            },
                            {
                                label: "Eyebrow Style",
                                value: appearance.face.foreheadBrows.eyebrowStyle
                            },
                            {
                                label: "Eyebrow Density",
                                value: appearance.face.foreheadBrows.eyebrowDensity
                            },
                            {
                                label: "Eyebrow Colour",
                                value: appearance.face.foreheadBrows.eyebrowColour.type
                            },
                            {
                                label: "Inner Eyebrow Height",
                                value: appearance.face.foreheadBrows.innerEyebrowHeight
                            },
                            {
                                label: "Brow Width",
                                value: appearance.face.foreheadBrows.browWidth
                            },
                            {
                                label: "Outer Eyebrow Height",
                                value: appearance.face.foreheadBrows.outerEyebrowHeight
                            },
                            {
                                label: "Temple Width",
                                value: appearance.face.foreheadBrows.templeWidth
                            },
                            {
                                label: "Eyebrow Depth",
                                value: appearance.face.foreheadBrows.eyebrowDepth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Nose</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Nose Type",
                                value: appearance.face.nose.noseType
                            },
                            {
                                label: "Laughter Lines",
                                value: appearance.face.nose.laughterLines
                            },
                            {
                                label: "Nose Height",
                                value: appearance.face.nose.noseHeight
                            },
                            {
                                label: "Nostril Width",
                                value: appearance.face.nose.nostrilWidth
                            },
                            {
                                label: "Nose Width",
                                value: appearance.face.nose.noseWidth
                            },
                            {
                                label: "Nose Tip Depth",
                                value: appearance.face.nose.noseTipDepth
                            },
                            {
                                label: "Nose Depth",
                                value: appearance.face.nose.noseDepth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Mouth</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Upper Lip Type",
                                value: appearance.face.mouth.upperLipType
                            },
                            {
                                label: "Lower Lip Type",
                                value: appearance.face.mouth.lowerLipType
                            },
                            {
                                label: "Mouth Height",
                                value: appearance.face.mouth.mouthHeight
                            },
                            {
                                label: "Lip Size",
                                value: appearance.face.mouth.lipSize
                            },
                            {
                                label: "Lip Width",
                                value: appearance.face.mouth.lipWidth
                            },
                            {
                                label: "Mouth Corner Height",
                                value: appearance.face.mouth.mouthCornerHeight
                            },
                            {
                                label: "Mouth Depth",
                                value: appearance.face.mouth.mouthDepth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Facial Hair</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Facial Hair Type",
                                value: appearance.face.facialHair.facialHairType
                            },
                            {
                                label: "Facial Hair Colour",
                                value: appearance.face.facialHair.facialHairColour?.type
                            },
                            {
                                label: "Thickness",
                                value: appearance.face.facialHair.thickness
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Cheeks / Chin / Jaw</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Cheek Type",
                                value: appearance.face.cheeksChinJaw.cheekType
                            },
                            {
                                label: "Neck Line Type",
                                value: appearance.face.cheeksChinJaw.neckLineType
                            },
                            {
                                label: "Cheekbones",
                                value: appearance.face.cheeksChinJaw.cheekbones
                            },
                            {
                                label: "Chin Height",
                                value: appearance.face.cheeksChinJaw.chinHeight
                            },
                            {
                                label: "Chin Width",
                                value: appearance.face.cheeksChinJaw.chinWidth
                            },
                            {
                                label: "Jaw Height",
                                value: appearance.face.cheeksChinJaw.jawHeight
                            },
                            {
                                label: "Jawline",
                                value: appearance.face.cheeksChinJaw.jawline
                            },
                            {
                                label: "Chin Depth",
                                value: appearance.face.cheeksChinJaw.chinDepth
                            }
                        ]}
                    />

                </div>

                <div class="appearance-subgroup">

                    <h4>Ears</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Ear Length",
                                value: appearance.face.ears.earLength
                            },
                            {
                                label: "Ear Width",
                                value: appearance.face.ears.earWidth
                            },
                            {
                                label: "Ear Angle",
                                value: appearance.face.ears.earAngle
                            }
                        ]}
                    />

                </div>

            </AppearanceGroup>
        )
    }

    {
        appearance.physique && (
            <AppearanceGroup title="Physique">

                <div class="appearance-subgroup">

                    <h4>Physical Features</h4>

                    <DataGrid
                        items={[
                            {
                                label: "Neck Length",
                                value: appearance.physique.neckLength
                            },
                            {
                                label: "Neck Size",
                                value: appearance.physique.neckSize
                            },
                            {
                                label: "Shoulder Height",
                                value: appearance.physique.shoulderHeight
                            },
                            {
                                label: "Shoulder Width",
                                value: appearance.physique.shoulderWidth
                            },
                            {
                                label: "Chest Measurement",
                                value: appearance.physique.chestMeasurement
                            },
                            {
                                label: "Waist Size",
                                value: appearance.physique.waistSize
                            },
                            {
                                label: "Arm Size",
                                value: appearance.physique.armSize
                            },
                            {
                                label: "Thigh Size",
                                value: appearance.physique.thighSize
                            },
                            {
                                label: "Calf Size",
                                value: appearance.physique.calfSize
                            },
                            {
                                label: "Leg Length",
                                value: appearance.physique.legLength
                            },
                            {
                                label: "Arm Length",
                                value: appearance.physique.armLength
                            }
                        ]}
                    />

                </div>

            </AppearanceGroup>
        )
    }

</section>

<style>
.player-version-appearance {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
}

.player-version-appearance__header {
    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.player-version-appearance__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.appearance-subgroup {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
}

.appearance-subgroup h4 {
    margin: 0;
    font-size: 1rem;
}
</style>