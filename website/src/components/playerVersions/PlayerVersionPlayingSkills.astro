---
import type { PlayingSkills } from "../../enums/playingSkills";

interface Props {
    playingSkills?: PlayingSkills[];
}

const { playingSkills } = Astro.props;
---

{
    playingSkills && playingSkills.length > 0 && (

        <section class="player-version-playing-skills">

            <header class="player-version-playing-skills__header">
                <h2>Playing Skills</h2>
            </header>

            <ul>

                {
                    playingSkills.map(skill => (
                        <li>
                            {skill}
                        </li>
                    ))
                }

            </ul>

        </section>

    )
}

<style>
.player-version-playing-skills {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);

    max-width: var(--content-width);
}

.player-version-playing-skills__header {
    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.player-version-playing-skills__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.player-version-playing-skills ul {
    display: flex;
    flex-wrap: wrap;

    gap: var(--space-2);
}

.player-version-playing-skills li {
    padding: var(--space-2) var(--space-3);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);

    color: var(--color-text);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}
</style>