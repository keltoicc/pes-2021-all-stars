---
import type { PlayerVersion } from "../../types/playerVersion";

import { getPositionCategory } from "../../lib/utils/getPositionCategory";

interface Props {
    positions: PlayerVersion["positions"];
}

const { positions } = Astro.props;
---

<section class="player-version-positions">

    <header class="player-version-positions__header">
        <h2>Positions</h2>
    </header>

    <ul>

        {
            Object.entries(positions).map(([position]) => {

                const category =
                    getPositionCategory(position);

                return (
                    <li class={`position--${category}`}>
                        {position}
                    </li>
                );

            })
        }

    </ul>

</section>

<style>
.player-version-positions {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);

    max-width: var(--content-width);
}

.player-version-positions__header {
    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.player-version-positions__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.player-version-positions ul {
    display: flex;
    flex-wrap: wrap;

    gap: var(--space-2);
}

.player-version-positions li {
    display: inline-flex;
    align-items: center;

    padding: var(--space-2) var(--space-3);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
}

.position--goalkeeper {
    color: var(--color-position-goalkeeper);
    border-color: var(--color-position-goalkeeper);
}

.position--defender {
    color: var(--color-position-defender);
    border-color: var(--color-position-defender);
}

.position--midfielder {
    color: var(--color-position-midfielder);
    border-color: var(--color-position-midfielder);
}

.position--forward {
    color: var(--color-position-forward);
    border-color: var(--color-position-forward);
}
</style>