---
import type { Country } from "../../types/country";

interface Props {
    country: Country;
}

const { country } = Astro.props;
---

<li>

    <a href={`/countries/${country.slug}`}>

        <div>

            <h2>{country.name}</h2>

            <p>{country.code}</p>

        </div>

    </a>

</li>