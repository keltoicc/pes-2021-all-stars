---
import type { Country } from "../../types/country";

interface Props {
    country: Country;
    hrefBase?: string;
}

const {
    country,
    hrefBase = "/countries"
} = Astro.props;
---

<li>

    <a href={`${hrefBase}/${country.slug}`}>

        <div>

            <h2>{country.name}</h2>

            <p>{country.code}</p>

        </div>

    </a>

</li>