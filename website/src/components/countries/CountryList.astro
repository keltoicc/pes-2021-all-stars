---
import type { Country } from "../../types/country";
import CountryListItem from "./CountryListItem.astro";

interface Props {
    countries: Country[];
}

const { countries } = Astro.props;
---

<section class="country-list">

    <header class="country-list__header">

        <h1>Countries</h1>

        <p>
            Browse every country represented in the project.
        </p>

        <p class="country-list__count">
            {countries.length} {countries.length === 1 ? "country" : "countries"}
        </p>

    </header>

    <ul>

        {
            countries.map(country => (
                <CountryListItem country={country} />
            ))
        }

    </ul>

</section>