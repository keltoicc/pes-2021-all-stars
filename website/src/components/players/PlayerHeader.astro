---
import type { Player } from "../../types/player";
import type { Country } from "../../types/country";

interface Props {
    player: Player;
    country: Country;
    secondCountry?: Country;
}

const {
    player,
    country,
    secondCountry
} = Astro.props;
---

<header class="player-header">

    <div class="player-header__content">

        <div class="player-header__identity">

            <h1>{player.name}</h1>

            <div class="player-header__countries">

                <a
                    class="player-header__country"
                    href={`${import.meta.env.BASE_URL}players/countries/${country.slug}/`}
                >
                    {country.name}
                </a>

                {
                    secondCountry && (

                        <>
                            <span class="player-header__country-separator">
                                ·
                            </span>

                            <a
                                class="player-header__country"
                                href={`${import.meta.env.BASE_URL}players/countries/${secondCountry.slug}/`}
                            >
                                {secondCountry.name}
                            </a>
                        </>

                    )
                }

            </div>

        </div>

        <dl>

            {
                player.birthDate && (

                    <div>

                        <dt>Birth date</dt>
                        <dd>{player.birthDate}</dd>

                    </div>
                )
            }

            {
                player.birthPlace && (

                    <div>

                        <dt>Birth place</dt>
                        <dd>{player.birthPlace}</dd>

                    </div>

                )
            }

            {
                player.preferredFoot && (

                    <div>

                        <dt>Preferred foot</dt>
                        <dd>{player.preferredFoot}</dd>

                    </div>
                )
            }

        </dl>

    </div>

</header>

<style>
.player-header {
    padding: var(--space-5) var(--space-4);

    background: var(--color-surface);

    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
}

.player-header__content {
    display: flex;
    flex-direction: column;

    gap: var(--space-6);
}

.player-header__identity {
    display: flex;
    flex-direction: column;

    gap: var(--space-2);
}

.player-header h1 {
    margin: 0;

    color: var(--color-text);

    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
}

.player-header__countries {
    display: flex;
    align-items: center;
    flex-wrap: wrap;

    gap: var(--space-2);
}

.player-header__country {
    color: var(--color-primary);

    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
}

.player-header__country:hover {
    text-decoration: underline;
}

.player-header dl {
    display: grid;

    grid-template-columns: repeat(3, minmax(0, 1fr));

    border-top: 1px solid var(--color-border);
}

.player-header dl > div {
    display: flex;
    flex-direction: column;

    gap: var(--space-1);

    padding-top: var(--space-4);
}

.player-header dl > div:not(:first-child) {
    padding-left: var(--space-4);

    border-left: 1px solid var(--color-border);
}

.player-header dt {
    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}

.player-header dd {
    margin: 0;

    color: var(--color-text);

    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
}

@media (max-width: 700px) {
    .player-header {
        padding: var(--space-4);
    }

    .player-header h1 {
        font-size: var(--font-size-2xl);
    }

    .player-header dl {
        grid-template-columns: 1fr;
    }

    .player-header dl > div {
        padding-block: var(--space-3);
    }

    .player-header dl > div:not(:first-child) {
        padding-left: 0;

        border-left: 0;
        border-top: 1px solid var(--color-border);
    }
}
</style>