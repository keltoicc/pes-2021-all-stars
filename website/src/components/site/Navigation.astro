---
interface NavigationItem {
    href: string;
    label: string;
}

const navigation: NavigationItem[] = [
    { href: "/pes-2021-all-stars/", label: "Home" },
    { href: "/pes-2021-all-stars/teams", label: "Teams" },
    { href: "/pes-2021-all-stars/players", label: "Players" },
    { href: "/pes-2021-all-stars/countries", label: "Countries" },
    { href: "/pes-2021-all-stars/continents", label: "Continents" },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-navigation" aria-label="Main navigation">

    <button
        class="site-navigation__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-navigation-menu"
    >
        <span>Menu</span>
        <span class="site-navigation__icon" aria-hidden="true">☰</span>
    </button>

    <ul id="site-navigation-menu">

        {
            navigation.map(item => {

                const isActive =
                    item.href === "/pes-2021-all-stars/"
                        ? currentPath === "/pes-2021-all-stars/"
                        : currentPath.startsWith(item.href);

                return (
                    <li>
                        <a
                            href={item.href}
                            class:list={{ active: isActive }}
                            aria-current={isActive ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    </li>
                );

            })
        }

    </ul>

</nav>

<script>
    const navigation = document.querySelector(".site-navigation");

    if (navigation) {

        const toggle = navigation.querySelector(
            ".site-navigation__toggle"
        );

        if (toggle) {

            toggle.addEventListener("click", () => {

                const isOpen =
                    toggle.getAttribute("aria-expanded") === "true";

                toggle.setAttribute(
                    "aria-expanded",
                    String(!isOpen)
                );

                navigation.classList.toggle(
                    "is-open",
                    !isOpen
                );

            });

        }

    }
</script>

<style>
.site-navigation {
    flex-shrink: 0;
}

.site-navigation ul {
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
}

.site-navigation a {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 72px;

    color: var(--color-text-secondary);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);

    transition:
        color 150ms ease;
}

.site-navigation a::after {
    content: "";

    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;

    height: 2px;

    background: var(--color-primary);

    opacity: 0;

    transition: opacity 150ms ease;
}

.site-navigation a.active {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
}

.site-navigation a.active::after {
    opacity: 1;
}

.site-navigation__toggle {
    display: none;
}

@media (max-width: 768px) {

    .site-navigation {
        position: relative;

        width: 100%;
    }

    .site-navigation__toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;

        width: 100%;

        padding: var(--space-4);

        color: var(--color-text-secondary);

        background: none;
        border: 0;

        font: inherit;
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-medium);

        cursor: pointer;
    }

    .site-navigation__icon {
        font-size: var(--font-size-lg);
    }

    .site-navigation ul {
        display: none;

        flex-direction: column;

        gap: 0;

        padding: var(--space-2) 0;

        border-top: 1px solid var(--color-border);
    }

    .site-navigation.is-open ul {
        display: flex;
    }

    .site-navigation a {
        min-height: auto;

        padding: var(--space-3) 0;
    }

    .site-navigation a::after {
        display: none;
    }

}
</style>