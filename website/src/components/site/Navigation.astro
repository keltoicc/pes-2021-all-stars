---
const navigation = [
    {
        href: "/",
        label: "Home"
    },
    {
        href: "/teams",
        label: "Teams"
    },
    {
        href: "/players",
        label: "Players"
    },
    {
        href: "/competitions",
        label: "Competitions"
    },
    {
        href: "/news",
        label: "News"
    },
    {
        href: "/about",
        label: "About"
    }
];
---

<nav aria-label="Main navigation">

    <ul>

        {
            navigation.map(item => (

                <li>

                    <a href={item.href}>
                        {item.label}
                    </a>

                </li>

            ))
        }

    </ul>

</nav>