---
interface NavigationItem {
    href: string;
    label: string;
}

const navigation: NavigationItem[] = [
    { href: "/pes-2021-all-stars/", label: "Home" },
    { href: "/pes-2021-all-stars/teams", label: "Teams" },
    { href: "/pes-2021-all-stars/continents", label: "Continents" },
    { href: "/pes-2021-all-stars/players", label: "Players" },
];

const currentPath = Astro.url.pathname;
---

<nav class="site-navigation" aria-label="Main navigation">

    <ul>

        {
            navigation.map(item => {

                const isActive =
                    item.href === "/pes-2021-all-stars/"
                        ? currentPath === "/pes-2021-all-stars/"
                        : currentPath.startsWith(item.href);

                return (
                    <li>
                        <a
                            href={item.href}
                            class:list={{ active: isActive }}
                            aria-current={isActive ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    </li>
                );

            })
        }

    </ul>

</nav>

<style>
.site-navigation {
    flex-shrink: 0;
}

.site-navigation ul {
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
}

.site-navigation a {
    position: relative;

    display: flex;
    align-items: center;

    min-height: 72px;

    color: var(--color-text-secondary);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);

    transition:
        color 150ms ease;
}

.site-navigation a::after {
    content: "";

    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;

    height: 2px;

    background: var(--color-primary);

    opacity: 0;

    transition: opacity 150ms ease;
}

.site-navigation a.active {
    color: var(--color-primary);
    font-weight: var(--font-weight-semibold);
}

.site-navigation a.active::after {
    opacity: 1;
}

@media (max-width: 768px) {

    .site-navigation {
        width: 100%;

        overflow-x: auto;
        scrollbar-width: none;
    }

    .site-navigation::-webkit-scrollbar {
        display: none;
    }

    .site-navigation ul {
        width: max-content;

        gap: var(--space-4);
    }

    .site-navigation a {
        min-height: auto;

        padding-block: var(--space-2);
    }
}
</style>