---
import Navigation from "./Navigation.astro";
---

<header class="site-header">

    <div class="container site-header__inner">

        <a
            href={`${import.meta.env.BASE_URL}`}
            class="brand"
            aria-label="PES 2021 All-Stars"
        >

            <img
                class="brand__logo"
                src={`${import.meta.env.BASE_URL}images/branding/logo.png`}
                alt="PES 2021 All-Stars"
            />

            <img
                class="brand__isotipo"
                src={`${import.meta.env.BASE_URL}images/branding/isotipo.png`}
                alt=""
                aria-hidden="true"
            />

        </a>

        <Navigation />

    </div>

</header>

<style>
.site-header {
    position: relative;
    z-index: 10;

    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
}

.site-header__inner {
    min-height: 144px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: var(--space-6);
}

.brand {
    display: flex;
    align-items: center;

    flex-shrink: 0;

    color: inherit;
    text-decoration: none;
}

.brand:hover {
    color: inherit;
}

.brand__logo {
    display: block;

    width: 360px;
    height: auto;

    max-height: 104px;

    object-fit: contain;
}

.brand__isotipo {
    display: none;

    width: 88px;
    height: 88px;

    object-fit: contain;
}

@media (max-width: 768px) {

    .site-header__inner {
        align-items: center;

        gap: var(--space-4);

        padding-block: var(--space-4);
    }

    .brand__logo {
        display: none;
    }

    .brand__isotipo {
        display: block;
    }
}
</style>