---
import type { SquadMemberSummary } from "../../viewModels/SquadMemberSummary";

interface Props {
    member: SquadMemberSummary;
}

const { member } = Astro.props;

const playerVersion = member.playerVersion;

const seasons = playerVersion
    ? (
        playerVersion.fromSeason === playerVersion.toSeason
            ? playerVersion.fromSeason
            : `${playerVersion.fromSeason}–${playerVersion.toSeason}`
    )
    : undefined;
---

<li class="squad-member-list-item">

    {
        playerVersion ? (

            <a
                href={`${import.meta.env.BASE_URL}player-versions/${playerVersion.slug}`}
            >

                <div class="squad-member-list-item__info">

                    <h3>
                        {member.player?.name ?? member.member.playerName}
                    </h3>

                    <p>
                        {playerVersion.version}
                        <span aria-hidden="true">·</span>
                        {seasons}
                    </p>

                </div>

                <div class="squad-member-list-item__position">

                    {playerVersion.mainPosition}

                </div>

                <span
                    class="squad-member-list-item__arrow"
                    aria-hidden="true"
                >
                    →
                </span>

            </a>

        ) : (

            <div class="squad-member-list-item__name">

                <h3>
                    {member.member.playerName}
                </h3>

            </div>

        )
    }

</li>

<style>
.squad-member-list-item {
    border-bottom: 1px solid var(--color-border);
}

.squad-member-list-item:first-child {
    border-top: 1px solid var(--color-border);
}

.squad-member-list-item a {
    display: flex;
    align-items: center;

    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    color: inherit;

    transition:
        background-color 0.15s ease,
        color 0.15s ease;
}

.squad-member-list-item__info {
    min-width: 0;

    flex: 1;
}

.squad-member-list-item__name {
    display: flex;
    align-items: center;

    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    color: inherit;

    transition:
        background-color 0.15s ease,
        color 0.15s ease;
    
    min-width: 0;

    flex: 1;
}

.squad-member-list-item h3 {
    margin: 0;

    font-size: var(--font-size-md);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-tight);
}

.squad-member-list-item p {
    display: flex;
    align-items: center;

    gap: var(--space-2);

    margin: var(--space-1) 0 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
}

.squad-member-list-item__position {
    flex-shrink: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
}

.squad-member-list-item__arrow {
    flex-shrink: 0;

    margin-left: var(--space-2);

    color: var(--color-text-muted);

    transition:
        color 150ms ease,
        transform 150ms ease;
}

.squad-member-list-item a:hover {
    color: var(--color-primary);
}

.squad-member-list-item a:hover p,
.squad-member-list-item a:hover .squad-member-list-item__position {
    color: var(--color-text-secondary);
}

.squad-member-list-item a:hover .squad-member-list-item__arrow {
    color: var(--color-primary);

    transform: translateX(3px);
}

.squad-member-list-item a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
}

@media (max-width: 600px) {

    .squad-member-list-item a {
        gap: var(--space-3);
    }

    .squad-member-list-item__position {
        font-size: var(--font-size-xs);
    }

}
</style>