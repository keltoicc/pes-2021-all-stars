---
import SquadMemberListItem from "./SquadMemberListItem.astro";

import type { SquadMemberSummary } from "../../viewModels/SquadMemberSummary";

interface Props {
    members: SquadMemberSummary[];
}

const { members } = Astro.props;
---

<section class="squad-member-list">

    <header class="squad-member-list__header">

        <h2>Players</h2>

        <p class="squad-member-list__count">
            {members.length} {members.length === 1 ? "player" : "players"}
        </p>

    </header>

    {
        members.length === 0 ? (

            <p class="squad-member-list__empty">
                No players available.
            </p>

        ) : (

            <ul>

                {
                    members.map(member => (
                        <SquadMemberListItem member={member} />
                    ))
                }

            </ul>

        )
    }

</section>

<style>
.squad-member-list {
    display: flex;
    flex-direction: column;

    gap: var(--space-4);

    max-width: var(--content-width);
}

.squad-member-list__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;

    gap: var(--space-4);

    padding: var(--space-3) var(--space-4);

    border-bottom: 1px solid var(--color-border);
}

.squad-member-list__header h2 {
    margin: 0;

    font-size: var(--font-size-xl);
}

.squad-member-list__count {
    margin: 0;

    color: var(--color-text-muted);

    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
}

.squad-member-list__empty {
    color: var(--color-text-muted);
}
</style>